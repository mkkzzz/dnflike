# 行尾规范
#
# Godot 在导入资源时用 LF 重写 .import 文件；而本机 core.autocrlf=true 期望工作区为 CRLF。
# 两者不一致会让 git status 把数百个 .import 判定为已修改，实际内容完全一致（git diff 为空）。
# 显式声明该类型为 LF，让索引与工作区期望一致，从根上消除假脏。
*.import text eol=lf

# v7 的源配置与导出记录含文件哈希，跨 clone 保持 LF，避免换行改写导致校验不一致。
art/animations/players/swordsman/v7/sources/**/*.json text eol=lf
art/animations/players/swordsman/v7/sources/proportion_reset_c3/**/prompt.txt text eol=lf
art/animations/players/swordsman/v7/sources/layer_trial_c3/**/prompt_*.txt text eol=lf
art/animations/players/swordsman/v7/sources/base_batch_c4/**/prompt_*.txt text eol=lf
art/animations/players/swordsman/v7/exports/**/*.json text eol=lf
art/animations/players/swordsman/v7/reviews/**/*.json text eol=lf
art/concepts/characters/players/swordsman/standard_v1/measurements/*.json text eol=lf

# 动作源图/消费副本和评审记录共用哈希；检出时不能转成 CRLF。
game/assets/swordsman_v7_*/**/*.json text eol=lf
art/animations/players/swordsman/v7/sources/**/*prompt*.txt text eol=lf
docs/previews/v7_c*/**/*.html text eol=lf
docs/previews/v7_c*/**/*.json text eol=lf
tools/**/*swordsman*.py text eol=lf
tools/actor_motion.py text eol=lf
tools/motion_neural.py text eol=lf
tools/setup_motion_model.py text eol=lf

# 交接日志只在末尾追加：按行合并，两个工作区同时追加不会冲突（改旧行会产生重复行，故禁止改旧行）
docs/project/04_交接日志.md merge=union
