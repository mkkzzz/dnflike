  "npcs": {
    "danjin": {
      "name": "土罐",
      "services": [
        "shop"
      ],
      "dialogue": "要不要来点罐子？艾尔文的罐子最结实。"
    },
    "linus": {
      "name": "林纳斯",
      "services": [
        "shop",
        "trade",
        "repair"
      ],
      "dialogue": "冒险的路还很长，记得检查武器和药剂。"
    },
    "seria": {
      "name": "赛丽亚",
      "services": [],
      "dialogue": "你好，冒险家。林纳斯大叔就在外面的铁匠铺，出发前先去和他打个招呼吧。"
    },
    "pungjin": {
      "name": "风振",
      "services": [],
      "dialogue": "欢迎来到赫顿玛尔。我是风振。若想了解这座城和自己的道路，不妨先去后街拜访辛达。"
    },
    "sinda": {
      "name": "辛达",
      "services": [
        "enchant",
        "equipment",
        "trade",
        "repair"
      ],
      "dialogue": "我是这里的铁匠辛达。磨炼技艺之前，先了解自己的职业和装备。鬼剑士的修行，也可以向G.S.D请教。"
    },
    "gsd": {
      "name": "G.S.D",
      "services": [
        "skills"
      ],
      "dialogue": "年轻的鬼剑士，左臂中的力量并非只有毁灭。先学会驾驭它，再决定自己的道路。"
    },
    "kanna": {
      "name": "卡妮娜",
      "services": [
        "trade"
      ],
      "dialogue": "欢迎来到赫顿玛尔！这里的街道很热闹，第一次来可不要迷路哦。"
    },
    "kiri": {
      "name": "凯丽",
      "services": ["reinforce"],
      "dialogue": "我是凯丽。冒险靠的不只是运气，也得多练练自己的本领。"
    },
    "norton": {
      "name": "诺顿",
      "services": [
        "trade",
        "disassemble"
      ],
      "dialogue": "科学能让旧装备焕发新的价值。把不需要的装备交给我，分解前先确认材料产出。"
    },
    "grandis": {
      "name": "歌兰蒂斯",
      "services": [],
      "dialogue": "愿你在旅途中守护自己的信念，也愿你平安归来。"
    },
    "albert": {
      "name": "阿尔伯特",
      "services": [],
      "dialogue": "想变强就多去实战。看清对手的动作，才能找到自己的机会。"
    },
    "shylock": {
      "name": "夏洛克",
      "services": [],
      "dialogue": "我是夏洛克，赫顿玛尔的哥布林商人。你想打听格兰之森？先说清楚来意，我可不喜欢被当成森林里的那些家伙。"
    }
  },
