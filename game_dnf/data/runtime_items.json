      "text_script_sha256": "1cbc87097459e496680f5e70f71b77a1a9429fea0e2b1b49b5aea45ac370cb0a"
    },
    "n_quest/handonmyre/mirkwood/epic_2_mirkwood_mutant_2.qst": {
      "fields": {
        "[condition message]": "前往格兰之森的『幽暗密林』， 杀死领主牛头巨兽。 (沿着风振的左侧走就可以进入格兰之森地下城)",
        "[depend message]": "格兰之森原本是精灵的丛林， 自从那场大火灾过后， 丛林里的动植物就开始变得疯狂了， 而且还出现了不知名的奇怪生命体。\n更让人疑惑的是那些原本和我们非常友好的牛头怪， 不知为什么突然转了性子， 常常偷袭在丛林中穿行的赫顿玛尔居民。\n眼看越来越多的人被它们伤害， 我们不能再任由它们这样疯狂下去！ 所以冒险家， 拜托你了！",
        "[name]": "狂暴的牛头巨兽",
        "[solve message]": "你进入格兰之森的丛林了？ 那里的情况怎么样了？"
      },
      "references": {
        "[condition message]": {
          "origin": "1031",
          "string_index": 457798,
          "encoding": "gb18030",
          "needs_review": false
        },
