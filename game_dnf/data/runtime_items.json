          "needs_review": false
        }
      },
      "text_script_sha256": "97bda13db4ca745db1dadecd39ecc312efd9a0bbc218857aa7280057dfa7ff8e"
    },
    "n_quest/handonmyre/mirkwood/epic_2_mirkwood_mutant_1.qst": {
      "fields": {
        "[condition message]": "前往赫顿玛尔找风振谈谈。 (沿着艾尔文防线左侧走就可以到赫顿玛尔)",
        "[depend message]": "你最近成长了不少啊， 哈哈， 既然我的事情都解决了， 你就开始新的冒险吧！ 你听说过流动的丛林格兰之森吗？ 冒险家都去那了， 你也赶紧去吧！\n嗯， 如果你不知道怎么去， 就沿着艾尔文防线左侧走， 那里通往赫顿玛尔。 然后你去找一个叫风振的人， 他会告诉你接下来要做什么。",
        "[name]": "流动的丛林",
        "[solve message]": "你是第一次来这儿吧？ 你想开始新的冒险啊， 呵呵， 那就从平定格兰之森的混乱开始吧！"
      },
      "references": {
        "[condition message]": {
          "origin": "1031",
          "string_index": 457794,
          "encoding": "gb18030",
          "needs_review": false
        },
