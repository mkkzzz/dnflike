  "text_source_sha256": "f761f58f5c913a1119f7661e266f2e85129bcf6b8230068e30b6dd21ae073c29",
  "quest_text": {
    "n_quest/elvengard/lorien/epic_1_lorien_1.qst": {
      "fields": {
        "[condition message]": "前往艾尔文防线拜访铁匠林纳斯。",
        "[depend message]": "那些胆小的哥布林为什么会突然变得这幺狂暴……而且阿拉德大陆最近常常出现这种奇怪的现象……难道……？\n啊！ 对不起， 我只顾想事情……您说要去冒险啊？ 但您好像还不太熟悉周边的环境啊， 很多冒险家都是先熟悉周边环境再去冒险的。\n嗯……您就先去艾尔文防线找林纳斯大叔吧， 他是一位手艺超级棒的铁匠， 而且很喜欢和冒险家来往， 他一定会帮助您的。",
        "[name]": "铁匠林纳斯",
        "[solve message]": "你就是赛丽亚的救命恩人？ 嗯， 看你的样子不太像啊。 不过既然你能从哥布林手里救出赛丽亚， 我就暂且当你是个不错的人吧！"
      },
      "references": {
        "[condition message]": {
          "origin": "1031",
          "string_index": 456397,
          "encoding": "gb18030",
          "needs_review": false
        },
        "[depend message]": {
          "origin": "1031",
          "string_index": 456396,
          "encoding": "gb18030",
          "needs_review": false
        },
        "[name]": {
          "origin": "1031",
          "string_index": 456395,
          "encoding": "gb18030",
          "needs_review": false
        },
        "[solve message]": {
          "origin": "1031",
          "string_index": 456398,
          "encoding": "gb18030",
          "needs_review": false
        }
      },
      "text_script_sha256": "2e5873b9dc92f75a2c983444eba65a772ebf8c5fad97aa4c6fa65ca4f94072d0"
    },
    "n_quest/elvengard/lorien/epic_1_lorien_2.qst": {
      "fields": {
        "[condition message]": "通关洛兰地区的『洛兰』。 (沿着艾尔文防线的右侧走就可以进入洛兰地下城)",
        "[depend message]": "你还不熟悉艾尔文防线吧？ 这里是通往精灵圣地格兰之森的惟一入口， 不过现在是那些低等生物哥布林的地盘了。\n唉， 这事说来话长， 自从格兰之森发生大火灾后， 居住在那里的精灵就突然消失了， 这一带一直怪事不断呢。\n冒险家， 既然你选择来阿拉德大陆冒险， 那就先从这里开始吧！",
        "[name]": "开始冒险",
        "[solve message]": "嗯， 不错不错， 不愧是赛丽亚的救命恩人呐！ 有点武术基础！ 呵呵， 我有点期待你日后的表现了， 好好努力吧！"
      },
      "references": {
        "[condition message]": {
          "origin": "1031",
          "string_index": 456401,
          "encoding": "gb18030",
          "needs_review": false
        },
        "[depend message]": {
          "origin": "1031",
          "string_index": 456400,
          "encoding": "gb18030",
          "needs_review": false
        },
        "[name]": {
          "origin": "1031",
          "string_index": 456399,
          "encoding": "gb18030",
          "needs_review": false
        },
        "[solve message]": {
          "origin": "1031",
          "string_index": 456402,
          "encoding": "gb18030",
          "needs_review": false
        }
      },
      "text_script_sha256": "12a30465eae16c8a5b4c5d66f1c3449d527199a266d11d0cc2da281f189844e1"
    },
    "n_quest/elvengard/lorieninside/epic_2_lorieninside_3.qst": {
      "fields": {
        "[condition message]": "前往洛兰地区的『洛兰深处』， 杀死10只哥布林， 然后向林纳斯回复。 (沿着艾尔文防线右侧走， 就可以进入洛兰深处地下城)",
        "[depend message]": "噢， 还有一件事要请你帮忙。 你知道吗？ 那些哥布林不知怎么了， 突然往洛兰深处疯狂聚集， 周边地区已经陷入一片混乱了。\n你快去除掉它们吧！ 不然周边的居民就要遭殃了！",
        "[name]": "噪音公害",
        "[solve message]": "哈哈， 你的身手还不错啊！ 送你一件武器吧， 不要嫌弃我的手艺， 你肯定会喜欢它的， 呵呵！"
      },
      "references": {
        "[condition message]": {
          "origin": "1031",
          "string_index": 456405,
          "encoding": "gb18030",
          "needs_review": false
        },
        "[depend message]": {
