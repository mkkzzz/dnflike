# 临时产物，不提交
temp/

# Godot 编辑器二进制（另机用 tools/setup_godot.ps1 安装）
tools/godot/

# Godot 工程本地缓存
game/.godot/

# Godot 导入缓存
game_dnf/.godot/

# 运行时资源随仓库分发（clone 后直接可跑）；只排除本机安装/构建标记
game_dnf/assets_local/.asset_store_install.json
game_dnf/assets_local/.combat_local_build.json
game_dnf/assets_local/.flow_install.json
game_dnf/assets_local/.items_install.json
game_dnf/assets_local/build_validation.json

# 烘焙贴图：由 tools/bake_game_assets.py 从 render_preview.py 生成，不入库
game/art/

# Python
__pycache__/
*.pyc

# 系统文件
Thumbs.db
.DS_Store

# 本地工作区标识与同步位置（每个 clone 各自不同），由 tools/sync_status.py --init 生成
.workspace

# 逆向中间产物（由 tools/parse_dnf_ai.py 再生成，体积大且含原版脚本字节）
game_dnf/data/ai_program.json
