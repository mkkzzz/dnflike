{
  "note": "AI 动作帧图 → 实机帧条的规格。改完后跑 python tools/bake_ai_frames.py；产物写 game/art/anim.json，Godot 侧零改动。",
  "how_to": {
    "背景": "纯绿幕（#00FF00 附近），不要加影子/地面/渐变；绿幕抠图见 make_anim.key_green",
    "网格": "每张图按 rows x cols 均分，每格一个动作帧，格内角色不越界、不重叠",
    "一致性": "同一张图内角色外形必须完全一致（同一提示词一次出图，这是文档里验证过的做法）",
    "朝向": "一律朝右（+1）。朝左由 Godot 水平翻转，不要出朝左的图",
    "尺寸": "单格不要小于 512x512，出图越大越好，脚本会归一化到 target_body_h",
    "禁止": "不要在图上画刀光/残影/速度线（那是实机 FX 的活，会切帧错位）；不要画血条/UI",
    "命名": "art/sheets/<group>/<action>.png"
  },
  "reference": {
    "定稿标杆": "art/characters/hero_cool.png —— 银白刺发带一缕红挑染、左眼角刀疤、红瞳、黑色皮革长风衣、血红内衬、银扣、左臂缠红绷带冒暗红火焰、黑柄长刀",
    "哥布林": "art/characters/goblin.png —— 尖耳、黄眼、獠牙、钉刺木棒",
    "已弃用勿参照": [
      "art/characters/benchmark_board.png",
      "art/characters/hero_idle.png",
      "art/characters/hero_attack.png"
    ]
  },
  "tuning": {
    "target_body_h": "角色**身体**（不含刀/发梢）在 1280x720 实机上的目标高度。改了必须同步按同比例改碰撞盒，否则视觉和判定会错位。",
    "player_192": "当前实机观感尺度（与地牢背景构图已验证协调）。若用这档，碰撞盒需按 ~1.8x 放大：moves.json 的 hitbox.h 100~110 → 180~200、hitbox.x 42~52 → 76~94；player.gd 近战怪物盒 60 → 108；monster.gd 碰撞体 50 → 90",
    "player_104": "M1 碰撞盒实际假定的尺度（旧 draw_rect 占位约 95px 高）。用这档无需改任何判定数值，但角色在 720p 画面上偏小",
    "reach_note": "另外还有一个独立问题：preview 的攻击前伸约为身高的 98%，Godot 现在只有 44%。即使角色尺度对齐，攻击距离仍需单独调 moves.json 的 hitbox.x"
  },
