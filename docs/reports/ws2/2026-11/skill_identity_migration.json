 "baseline_numbers_sha256": "ac681561de6cdf6d13e863f696354ec686b3b990c2b689a2d118d70da55995b8",
 "baseline_probe": "extends SceneTree\nconst Old = preload(\"D:/dnf like/dnflike/temp/skill_identity_old_numbers.gd\")\nconst Current = preload(\"res://stats/api/numbers.gd\")\nconst Session = preload(\"res://flow/session.gd\")\n\nfunc _initialize() -> void:\n\tvar rows: Array = []\n\tvar session = Session.new()\n\tsession.command(\"numbers.level\",{\"level\":60})\n\tfor alias: String in Current.shared_config()[\"skill_aliases\"]:\n\t\tvar id: String = Current.shared_config()[\"skill_aliases\"][alias][\"id\"]\n\t\tvar profile: Dictionary = session.profile.duplicate(true)\n\t\tprofile[\"skills\"][alias]=3\n\t\tprofile[\"skills\"][id]=2\n\t\tprofile[\"skill_purchases\"][alias]=[20,20,20]\n\t\tprofile[\"skill_purchases\"][id]=[20,20]\n\t\tvar before := profile.duplicate(true)\n\t\tOld.normalize(before)\n\t\tvar after := profile.duplicate(true)\n\t\tCurrent.normalize(after)\n\t\tvar old_values: Dictionary = Old.profile_stats(before)[\"values\"]\n\t\tvar new_values: Dictionary = Current.profile_stats(after)[\"values\"]\n\t\tvar changed := {}\n\t\tfor stat in old_values:\n\t\t\tif old_values[stat]!=new_values[stat]:changed[stat]=[old_values[stat],new_values[stat]]\n\t\trows.append({\"alias\":alias,\"target\":id,\"before_live_ranks\":[before[\"skills\"][alias],before[\"skills\"][id]],\n\t\t\t\"after_rank\":after[\"skills\"][id],\"after_alias_present\":after[\"skills\"].has(alias),\n\t\t\t\"sp_before\":Old.Skills.available(before,Old.shared_config()),\"sp_after\":Current.Skills.available(after,Current.shared_config()),\n\t\t\t\"before_valid\":Old.valid(before),\"after_valid\":Current.valid(after),\"changed_values\":changed})\n\tvar file := FileAccess.open(\"D:/dnf like/dnflike/temp/skill_identity_baseline.json\",FileAccess.WRITE)\n\tfile.store_string(JSON.stringify(rows,\" \"))\n\tfile.close()\n\tprint(\"[IDENTITY_BASELINE] compared=\",rows.size())\n\tquit()\n",
